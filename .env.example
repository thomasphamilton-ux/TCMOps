# Copy this file to .env and fill in real values. Never commit .env.

# Backend
PORT=3000
JWT_SECRET=
# Password here must match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://postgres:password@db:5432/quicktime
# Comma-separated list of allowed frontend origins, e.g. https://tcm.yourcompany.com
# In production, do NOT leave this blank — the backend falls back to allowing
# any origin (dev-only convenience) when it's unset.
CORS_ORIGIN=

# Postgres container credentials (docker-compose db service). Must match the
# password segment of DATABASE_URL above.
POSTGRES_PASSWORD=password

# First admin account (created by `npm run db:seed` in backend/) — change the
# PIN after first login. Use a real phone number and a PIN longer than the
# dev default for production.
SEED_ADMIN_PHONE=
SEED_ADMIN_PIN=

# Outbound email for export notifications (optional — exports still work without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=quicktime@example.com

# Public domain this app is served from. SSL itself is handled by Plesk on
# the VPS (not by this app) — this is just used for CORS_ORIGIN reference /
# documentation.
DOMAIN=
